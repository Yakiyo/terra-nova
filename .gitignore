__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# Raw downloads (~1.1 GB) are reproducible from src/acquire. The derived
# arrays and the predictor stack stay in the repo so the demo, the tests and
# `--stage assemble` all run with OFFLINE=1.
cache/raw/*
# ...except the small vector files the offline gazetteer and land mask need.
!cache/raw/ne_*.geojson

# Legacy prototype kept out of this repository's history.
prototype_v1/

# Detail imagery tiles: large, re-fetchable (python -m src.acquire.tiles)
cache/tiles/

# God's Eye elevation and imagery tiles (python -m src.acquire.sitetiles)
cache/sitetiles/

# Relief-shaded hover previews (built on demand from EOX + AWS tiles)
cache/peek/

# Reproducible frontend review evidence and downloaded vendor staging.
artifacts/frontend/
cache/vendor/
# Panchang permits self-hosting, but not redistribution via a public repository.
web/vendor/fonts/panchang-*.woff2
